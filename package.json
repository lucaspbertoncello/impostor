{
  "name": "impostor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0"
  },
  "imports": {
    "#/*": "./src/*",
    "#scripts/*": "./scripts/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "captures": "node scripts/captures/take-captures.script.ts",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "[ \"$(git branch --show-current)\" != \"main\" ] || [ \"$ALLOW_MAIN_COMMIT\" = \"1\" ] || { echo 'Commit na main so com o ok de Lucas: ALLOW_MAIN_COMMIT=1 (veja AGENTS.md).'; exit 1; }",
    "commit-msg": "pnpm exec commitlint --edit \"$1\"",
    "pre-push": "[ \"$ALLOW_MAIN_PUSH\" = \"1\" ] || ! grep -q ' refs/heads/main ' || { echo 'Push na main so com o ok de Lucas: ALLOW_MAIN_PUSH=1 (veja AGENTS.md).'; exit 1; }"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/lilita-one": "5.3.0",
    "@tanstack/react-router": "1.170.45",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
